<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>نتایج پردازش | Repo 2 TXT</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    body { font-family: 'Vazirmatn', sans-serif; direction: rtl; background: #f1f5f9; }
    .glass { background: white; border-radius: 2rem; box-shadow: 0 20px 40px -10px rgba(0,0,0,0.1); }
    .stat-card { background: #f8fafc; border-radius: 1rem; padding: 1.5rem; border: 1px solid #e2e8f0; }
    .stat-card .value { font-size: 2rem; font-weight: 700; color: #1e293b; }
    .stat-card .label { color: #64748b; font-size: 0.875rem; }
    .lang-badge { display: inline-block; padding: 0.2rem 0.8rem; border-radius: 9999px; font-size: 0.75rem; background: #e2e8f0; margin: 0.2rem; }
    .progress-bar { height: 8px; background: #e2e8f0; border-radius: 9999px; overflow: hidden; }
    .progress-bar .fill { height: 100%; background: linear-gradient(90deg, #7c3aed, #6d28d9); }
  </style>
</head>
<body>
  <div class="container mx-auto px-4 py-8 max-w-5xl">
    <div class="glass p-8 md:p-10">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-800">
            <i class="fas fa-check-circle text-green-500"></i> نتایج پردازش
          </h1>
          <p class="text-gray-500 text-sm mt-1">
            <i class="fas fa-folder"></i> <%- rootPath || 'پوشه' %>
          </p>
        </div>
        <a href="/" class="btn-primary px-6 py-2 bg-indigo-600 text-white rounded-full hover:bg-indigo-700 transition text-sm">
          <i class="fas fa-arrow-left"></i> بازگشت
        </a>
      </div>

      <!-- آمار کل -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="stat-card">
          <div class="value"><%= stats?.totalFiles || 0 %></div>
          <div class="label">تعداد فایل‌ها</div>
        </div>
        <div class="stat-card">
          <div class="value"><%= stats?.totalSizeFormatted || '0 B' %></div>
          <div class="label">حجم کل</div>
        </div>
        <div class="stat-card">
          <div class="value"><%= stats?.totalLines || 0 %></div>
          <div class="label">خطوط کد</div>
        </div>
        <div class="stat-card">
          <div class="value"><%= stats?.languages?.length || 0 %></div>
          <div class="label">زبان‌های برنامه‌نویسی</div>
        </div>
      </div>

      <!-- پیشرفت (در صورت وجود) -->
      <% if (stats?.durationMs) { %>
        <div class="mb-6 bg-gray-50 p-4 rounded-xl">
          <div class="flex justify-between text-sm text-gray-600 mb-1">
            <span>زمان پردازش</span>
            <span><%= (stats.durationMs / 1000).toFixed(2) %> ثانیه</span>
          </div>
          <div class="progress-bar">
            <div class="fill" style="width: 100%"></div>
          </div>
        </div>
      <% } %>

      <!-- زبان‌ها -->
      <div class="mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-3">زبان‌های برنامه‌نویسی</h2>
        <div class="flex flex-wrap gap-2">
          <% if (stats?.languages && stats.languages.length > 0) { %>
            <% stats.languages.forEach(lang => { %>
              <span class="lang-badge" style="background: <%= lang.language?.color || '#e2e8f0' %>20; border: 1px solid <%= lang.language?.color || '#e2e8f0' %>">
                <span style="color: <%= lang.language?.color || '#1e293b' %>">
                  <i class="fas fa-code"></i> <%= lang.name %>
                </span>
                <span class="text-gray-500 text-xs">(<%= lang.fileCount %> فایل)</span>
              </span>
            <% }) %>
          <% } else { %>
            <span class="text-gray-400">هیچ زبانی تشخیص داده نشد</span>
          <% } %>
        </div>
      </div>

      <!-- بزرگ‌ترین فایل‌ها -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h2 class="text-xl font-bold text-gray-800 mb-3">
            <i class="fas fa-arrow-up text-red-500"></i> بزرگ‌ترین فایل‌ها
          </h2>
          <div class="space-y-2">
            <% if (stats?.largestFiles && stats.largestFiles.length > 0) { %>
              <% stats.largestFiles.forEach(f => { %>
                <div class="flex justify-between items-center bg-gray-50 p-2 rounded-lg text-sm">
                  <span class="font-mono text-gray-700 truncate max-w-[60%]"><%= f.path %></span>
                  <span class="text-gray-500"><%= f.sizeFormatted || f.size + ' B' %></span>
                </div>
              <% }) %>
            <% } else { %>
              <span class="text-gray-400">—</span>
            <% } %>
          </div>
        </div>
        <div>
          <h2 class="text-xl font-bold text-gray-800 mb-3">
            <i class="fas fa-clock text-blue-500"></i> جدیدترین فایل‌ها
          </h2>
          <div class="space-y-2">
            <% if (stats?.newestFiles && stats.newestFiles.length > 0) { %>
              <% stats.newestFiles.forEach(f => { %>
                <div class="flex justify-between items-center bg-gray-50 p-2 rounded-lg text-sm">
                  <span class="font-mono text-gray-700 truncate max-w-[60%]"><%= f.path %></span>
                  <span class="text-gray-500 text-xs"><%= new Date(f.modifiedAt).toLocaleDateString('fa-IR') %></span>
                </div>
              <% }) %>
            <% } else { %>
              <span class="text-gray-400">—</span>
            <% } %>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center text-gray-400 text-sm border-t border-gray-200 pt-6">
        <i class="fas fa-download"></i> فایل خروجی: <span class="font-mono"><%= outputFile || 'merged_files.txt' %></span>
      </div>
    </div>
  </div>
</body>
</html>
