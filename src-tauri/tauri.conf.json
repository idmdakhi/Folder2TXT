{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folder2Txt",
  "version": "2.0.1",
  "identifier": "com.folder2txt.desktop",
  "build": {
    "frontendDist": "../desktop-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Folder2Txt",
        "width": 1100,
        "height": 840,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
