{
  "name": "repo2txt",
  "version": "1.0.0",
  "description": "Convert repository structure and text files into a single TXT or Markdown document.",
  "type": "module",
  "bin": {
    "repo2txt": "./dist/apps/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx apps/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/cli/index.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "repository",
    "converter",
    "exporter",
    "tree",
    "typescript",
    "markdown",
    "txt"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}