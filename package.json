{
  "name": "repo2txt",
  "version": "1.0.0",
  "description": "Convert repository structure and text files into a single TXT or Markdown document.",
  "type": "module",
  "bin": {
    "repo2txt": "./dist/apps/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx apps/cli/index.ts",
    "dev:server": "tsx apps/server/index.ts",
    "dev:watch": "tsx apps/cli/index.ts --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/cli/index.js",
    "start:server": "node dist/apps/server/index.js",
    "start:watch": "node dist/apps/cli/index.js --watch",
    "clean": "rimraf dist logs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "repository",
    "converter",
    "exporter",
    "tree",
    "typescript",
    "markdown",
    "txt"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^4.18.0",
    "p-queue": "^7.4.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
